{
  "name": "nexa-social-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "HOST=127.0.0.1 PORT=4001 node --env-file=.env.local server/index.js",
    "server": "HOST=127.0.0.1 PORT=4001 node --env-file=.env.local server/index.js",
    "dev:all": "npm run db:migrate:local && concurrently \"npm run server\" \"npm run dev\"",
    "infra:up": "docker compose --profile local-storage up -d",
    "infra:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:baseline": "prisma migrate resolve --applied 20261001000000_initial_schema",
    "db:migrate": "prisma migrate deploy",
    "db:baseline:local": "node --env-file=.env.local ./node_modules/prisma/build/index.js migrate resolve --applied 20261001000000_initial_schema",
    "db:migrate:local": "node --env-file=.env.local ./node_modules/prisma/build/index.js migrate deploy",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "assets:pwa": "node scripts/generate-pwa-icons.js",
    "test": "node --test",
    "build": "npm run assets:pwa && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "sharp": "^0.35.5",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "prisma": "^6.12.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  }
}
